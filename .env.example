# Sales OS Environment Variables
# Copy this file to .env.local and fill in your values

# --- Database (required for cloud mode) ---
DATABASE_URL="postgresql://user:password@localhost:5432/sales_os?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="your-32-character-random-secret"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-32-character-random-secret"

# --- Email sender (manual sending via Hostinger Webmail) ---
SENDER_EMAIL="sales@health.valioz.com"

# --- Access code (legacy, for browser-only mode without Supabase) ---
ACCESS_CODE="your-access-code"

# --- Supabase (optional legacy sync) ---
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# --- Resend (optional, for real email sending) ---
RESEND_API_KEY=""

# Sales OS Environment Variables
# Copy this file to .env.local and fill in your values

# --- Database (Vercel Postgres or self-hosted PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# --- Auth (JWT-based) ---
JWT_SECRET="your-32-character-random-secret"
NEXTAUTH_SECRET="your-32-character-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Email sender ---
SENDER_EMAIL="sales@health.valioz.com"

# --- Resend (for real email sending via campaigns) ---
RESEND_API_KEY="re_1234567890abcdef"

# --- Legacy (optional, not required) ---
ACCESS_CODE=""
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

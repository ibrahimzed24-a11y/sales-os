// Prisma models mapped onto the EXISTING Supabase tables (snake_case, uuid ids, text enums).
// The schema is managed with SQL in supabase/migrations; Prisma only reads and writes it. Never run `prisma migrate` or `db push` against production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_users")
}

model Account {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  domain        String?
  industry      String?
  size          Int?      @default(0)
  annualRevenue Decimal?  @default(0) @map("annual_revenue") @db.Decimal
  tier          String?   @default("SMB")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  contacts      Contact[]

  ownerId String? @map("owner_id") @db.Uuid

  @@map("accounts")
}

model Contact {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId       String?   @map("account_id") @db.Uuid
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  email           String?
  phone           String?
  role            String?
  leadStatus      String?   @default("New") @map("lead_status")
  leadScore       Int?      @default(0) @map("lead_score")
  source          String?   @default("Inbound")
  tags            String[]
  owner           String?
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz(6)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerId String? @map("owner_id") @db.Uuid

  @@map("contacts")
}

model EmailTemplate {
  id        String   @id
  name      String
  subject   String?
  body      String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerId String? @map("owner_id") @db.Uuid

  @@map("email_templates")
}

model Campaign {
  id         String    @id
  name       String
  status     String?
  subject    String?
  templateId String?   @map("template_id")
  audience   Json?
  dailyLimit Int?      @map("daily_limit")
  notes      String?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerId String? @map("owner_id") @db.Uuid

  @@map("campaigns")
}

model EmailLog {
  id             String    @id
  campaignId     String?   @map("campaign_id")
  contactId      String?   @map("contact_id")
  toEmail        String?   @map("to_email")
  subject        String?
  body           String?
  status         String?
  error          String?
  gmailMessageId String?   @map("gmail_message_id")
  preparedAt     DateTime? @map("prepared_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerId String? @map("owner_id") @db.Uuid

  @@map("email_logs")
}

model ImportJob {
  id        String    @id
  entity    String
  fileName  String?   @map("file_name")
  total     Int?      @default(0)
  imported  Int?      @default(0)
  skipped   Int?      @default(0)
  report    Json?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerId String? @map("owner_id") @db.Uuid

  @@map("import_jobs")
}
